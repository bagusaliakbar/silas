<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to hidden files and sensitive configuration
    RewriteRule ^(\.env|composer\.(json|lock)|package(-lock)?\.json|\.git|\.github) - [F,L,NC]

    # Forward all incoming traffic to the public/ directory
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

